# WWH3 admin — template only. NEVER put real values in this file; it is
# committed to git. Copy it to `.env` (gitignored) for local `netlify dev`,
# and add the same variables in Netlify → Site configuration → Environment.

# Password for /admin. Generate with:
#   npm run hash-password -- "the club password"
ADMIN_PASSWORD_HASH=scrypt:<salt-hex>:<key-hex>

# Signs the 8-hour session cookie. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary account used for photo uploads.
# The API secret is only read by the server-side signing function.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder inside the Cloudinary account. Defaults to wwh3.
CLOUDINARY_FOLDER=wwh3
